ANTHROPIC_API_KEY=
SCAN_MODEL=
# Free alternative to Claude, used only when ANTHROPIC_API_KEY is empty.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: keeps each visitor's Grove (entries and photos) in Supabase under
# an anonymous user. Set both or neither; with neither, the Grove stays on the
# device. Safe to expose: row-level security limits the anon key to the
# caller's own rows. See supabase/README.md. The service-role key is not used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
